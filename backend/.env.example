JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_TEST_MODE="true"
UPLOAD_DIR="uploads"

# Copy to .env (never commit .env). All values below are local placeholders.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lrms?schema=public"
PORT=5000
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-min-32-chars-long-dev-only-secret"
